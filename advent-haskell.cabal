name:           advent-haskell
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/neillrobson/advent-haskell#readme>
homepage:       https://github.com/neillrobson/advent-haskell#readme
bug-reports:    https://github.com/neillrobson/advent-haskell/issues
author:         Neill Robson
maintainer:     neill@neillrobson.com
copyright:      2025 - Present
license:        BSD-3-Clause
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/neillrobson/advent-haskell

executable advent-haskell
  main-is: Main.hs
  other-modules:
      AOC2015.Day01
  hs-source-dirs:
      src
  default-extensions:
      ViewPatterns
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      advent-of-code-api
    , aeson >=2.2.3.0 && <2.3
    , base >=4.7 && <5
    , bytestring >=0.12.2.0 && <0.13
    , containers
    , deepseq
    , text
    , yaml >=0.11.11.2 && <0.12
  default-language: Haskell2010
